cat > .gitignore <<'EOF'
# ======================
# Python
# ======================
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# ======================
# Data & models (keep repo lightweight)
# ======================
data/*.csv
data/mlbb_data_backup.csv
data/mlbb_data_expanded.csv
external_data.csv
models/*.joblib
!data/sample.csv

# ======================
# macOS junk
# ======================
.DS_Store

# ======================
# IDE / Editor files
# ======================
.idea/
.vscode/
*.swp
*.swo